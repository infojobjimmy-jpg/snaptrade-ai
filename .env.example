# SnapTrade AI — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# On Railway, set these directly in the project's Variables panel.

# Required: Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Port for the Express server (Railway sets this automatically)
PORT=3000
