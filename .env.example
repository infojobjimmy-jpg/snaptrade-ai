# SnapTrade AI — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# On Railway, set these directly in the project's Variables panel.

# Required: Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Port for the Express server (Railway sets this automatically)
PORT=3000

# ── Market data ──────────────────────────────────────────────
# Optional: Twelve Data API key (forex / crypto / indices second pass)
TWELVE_DATA_API_KEY=

# ── Supabase (scan history, quotas, analytics) ───────────────
# Both required together, otherwise history + analytics are disabled.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Whop membership gating ───────────────────────────────────
WHOP_API_KEY=
WHOP_PLAN_ID_ESSAI=
WHOP_PLAN_ID_FONDATEUR=
WHOP_PLAN_ID_STANDARD=
WHOP_PLAN_ID_PRO=
WHOP_UPGRADE_URL=https://whop.com/snaptrade-ai

# ── Admin analytics console (/admin) ─────────────────────────
# Long random string. Required to open the /admin dashboard and
# to call GET /api/admin/stats. Generate: openssl rand -hex 24
ADMIN_TOKEN=

# ── Pont d'exécution EA MT5 ──────────────────────────────────
# Secret partagé entre ce serveur et l'EA SnapTradeBridge.mq5.
# Requis pour /api/bridge/*. Generate: openssl rand -hex 24
BRIDGE_TOKEN=
